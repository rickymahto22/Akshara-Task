PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/smartchat_ai
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
# Example: CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional: auto-create a default admin user on backend start (only if no admin exists yet)
ADMIN_NAME=SmartChat Admin
ADMIN_EMAIL=admin@smartchat.local
ADMIN_PASSWORD=admin123